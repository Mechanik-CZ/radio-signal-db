PORT=4000

# Firebase Console > Project settings > Service accounts > Generate new
# private key. Paste the ENTIRE downloaded JSON file as a single line here
# (or as the Render env var value - never commit this file with real values).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# Firebase Console > Realtime Database, the URL shown at the top.
FIREBASE_DATABASE_URL=https://radiosignaldb-default-rtdb.europe-west1.firebasedatabase.app

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGIN=http://localhost:3000,https://radio-signal-db.onrender.com

# Any random long string - used to hash voter IPs before storing them.
IP_HASH_SECRET=change-this-to-a-random-string
